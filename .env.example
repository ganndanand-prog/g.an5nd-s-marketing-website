# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RECIPIENT_EMAIL: Destination email address for collaboration & contact requests.
RECIPIENT_EMAIL="anand75io@moes.edu.mn"

# Option 1: Direct Gmail SMTP (recommended — no third-party activation links)
# Create a Google App Password in your Google Account Security settings.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Option 2: Resend API (alternative direct email provider)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"

# Option 3: Web3Forms Access Key (alternative form-to-email provider)
WEB3FORMS_ACCESS_KEY=""

# Option 4: FormSubmit activated alias token (optional fallback if using FormSubmit)
FORMSUBMIT_ENDPOINT=""

# DISCORD_WEBHOOK_URL: Server-side Discord webhook URL (never expose in client code)
DISCORD_WEBHOOK_URL=""
